# Trackademy Backend Environment Example
#
# Copy this file to .env for local development.
# The real production file lives in the VPS and must not be committed.

# Runtime
# local | staging | production
APP_ENVIRONMENT=local

# Database
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/trackademy_bd
QUARKUS_DATASOURCE_USERNAME=trackademy
QUARKUS_DATASOURCE_PASSWORD=change_me

# Flyway
# Production should keep this true once the database has been aligned with the tracked migrations.
# Existing populated databases may also need QUARKUS_FLYWAY_BASELINE_ON_MIGRATE=true on the first controlled rollout.
QUARKUS_FLYWAY_BASELINE_ON_MIGRATE=false
QUARKUS_FLYWAY_MIGRATE_AT_START=false

# HTTP bind
QUARKUS_HTTP_HOST=127.0.0.1
QUARKUS_HTTP_PORT=8080

# CORS
QUARKUS_HTTP_CORS=true
QUARKUS_HTTP_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
QUARKUS_HTTP_CORS_HEADERS=accept,authorization,content-type,x-requested-with
QUARKUS_HTTP_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
QUARKUS_HTTP_CORS_ALLOW_CREDENTIALS=true
QUARKUS_HTTP_LIMITS_MAX_BODY_SIZE=50M

# Microsoft OIDC / Quarkus token validation
# Keep disabled for the current local flow unless you intentionally configure OIDC.
QUARKUS_OIDC_TENANT_ENABLED=false
QUARKUS_OIDC_APPLICATION_TYPE=service
QUARKUS_OIDC_AUTH_SERVER_URL=
QUARKUS_OIDC_CLIENT_ID=
QUARKUS_OIDC_TOKEN_AUDIENCE=

# App auth: Microsoft id token exchange
APP_AUTH_MICROSOFT_FRONTEND_CLIENT_ID=<TRACKADEMY_MICROSOFT_FRONTEND_CLIENT_ID>
APP_AUTH_MICROSOFT_JWKS_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys
APP_AUTH_MICROSOFT_ISSUER_PREFIX=https://login.microsoftonline.com/

# App auth: Google id token exchange
APP_AUTH_GOOGLE_FRONTEND_CLIENT_ID=<TRACKADEMY_GOOGLE_WEB_CLIENT_ID>
APP_AUTH_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# App JWT
# Production must use a long random secret and must never use the local default.
APP_AUTH_JWT_SECRET=<RANDOM_LONG_SECRET_AT_LEAST_32_CHARS>
APP_AUTH_JWT_ISSUER=trackademy
APP_AUTH_JWT_TTL_SECONDS=28800

# WhatsApp / Meta Cloud API
# Leave empty in local if WhatsApp is not being tested.
# In production, if WhatsApp is enabled, all APP_WHATSAPP_* values below are required.
APP_WHATSAPP_ENABLED=false
APP_WHATSAPP_META_ACCESS_TOKEN=
APP_WHATSAPP_META_PHONE_NUMBER_ID=
APP_WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=
APP_WHATSAPP_META_APP_SECRET=
APP_WHATSAPP_META_API_VERSION=v23.0
APP_WHATSAPP_OFFICIAL_NUMBER=
APP_WHATSAPP_LINK_CODE_TTL_SECONDS=600
