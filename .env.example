# Trackademy Backend - Environment example
#
# Copia este archivo a .env para desarrollo local.
# El .env.prod real vive en la VPS y no se debe commitear.
#
# Valores marcados <PLACEHOLDER> deben reemplazarse antes de arrancar.
# Valores opcionales pueden quedar vacios si no usas esa funcionalidad.

# ---------- Runtime ----------
# local | staging | production
APP_ENVIRONMENT=local

# ---------- Datasource ----------
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/trackademy_bd
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=<DB_PASSWORD>

# ---------- Flyway ----------
# En produccion, encender una vez la BD este alineada con las migraciones versionadas.
# Bases ya pobladas pueden necesitar QUARKUS_FLYWAY_BASELINE_ON_MIGRATE=true en el primer rollout.
QUARKUS_FLYWAY_MIGRATE_AT_START=false
QUARKUS_FLYWAY_BASELINE_ON_MIGRATE=false

# ---------- HTTP ----------
QUARKUS_HTTP_HOST=127.0.0.1
QUARKUS_HTTP_PORT=8080

# ---------- CORS ----------
QUARKUS_HTTP_CORS=true
QUARKUS_HTTP_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
QUARKUS_HTTP_CORS_HEADERS=accept,authorization,content-type,x-requested-with
QUARKUS_HTTP_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
QUARKUS_HTTP_CORS_ALLOW_CREDENTIALS=true
QUARKUS_HTTP_LIMITS_MAX_BODY_SIZE=50M

# ---------- OIDC ----------
# Off por defecto: la autenticacion del producto va por validacion de id_token + JWT propio.
QUARKUS_OIDC_TENANT_ENABLED=false
QUARKUS_OIDC_APPLICATION_TYPE=service
QUARKUS_OIDC_AUTH_SERVER_URL=
QUARKUS_OIDC_CLIENT_ID=
QUARKUS_OIDC_TOKEN_AUDIENCE=

# ---------- Auth: Microsoft ----------
APP_AUTH_MICROSOFT_FRONTEND_CLIENT_ID=<MICROSOFT_FRONTEND_CLIENT_ID>

# ---------- Auth: Google ----------
APP_AUTH_GOOGLE_FRONTEND_CLIENT_ID=<GOOGLE_FRONTEND_CLIENT_ID>
APP_AUTH_GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
APP_AUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# ---------- App JWT ----------
# Produccion exige un secreto >=32 chars; el default local del codigo es rechazado por ProductionConfigValidator.
APP_AUTH_JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARS>
APP_AUTH_JWT_ISSUER=trackademy
APP_AUTH_JWT_TTL_SECONDS=28800
APP_FRONTEND_BASE_URL=http://localhost:4200

# ---------- WhatsApp / Meta Cloud API ----------
# Si APP_WHATSAPP_ENABLED=true en prod, ProductionConfigValidator exige todas las APP_WHATSAPP_* configuradas.
APP_WHATSAPP_ENABLED=false
APP_WHATSAPP_META_ACCESS_TOKEN=
APP_WHATSAPP_META_PHONE_NUMBER_ID=
APP_WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=
APP_WHATSAPP_META_APP_SECRET=
APP_WHATSAPP_META_API_VERSION=v23.0
APP_WHATSAPP_OFFICIAL_NUMBER=
APP_WHATSAPP_LINK_CODE_TTL_SECONDS=600

# ---------- Anthropic (analisis IA de silabos) ----------
# Vacio desactiva el analisis.
ANTHROPIC_API_KEY=

# ---------- Mailer (SMTP) ----------
# Vacio = no se envian correos (feedback y notificaciones). Configurar todo o nada.
QUARKUS_MAILER_FROM=
QUARKUS_MAILER_HOST=
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_START_TLS=REQUIRED
QUARKUS_MAILER_SSL=false
QUARKUS_MAILER_AUTH_METHODS=BASIC
QUARKUS_MAILER_USERNAME=
QUARKUS_MAILER_PASSWORD=
QUARKUS_MAILER_TRUST_ALL=false
QUARKUS_MAILER_MOCK=false

# ---------- Feedback ----------
# Destinatario de los reportes generados desde el frontend.
APP_FEEDBACK_EMAIL_DESTINO=

# ---------- Image upload (ImgBB) ----------
# Vacio desactiva el upload (los reportes de feedback aceptaran texto sin imagen).
APP_UPLOAD_IMGBB_API_KEY=
